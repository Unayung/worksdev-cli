def cmd_app_grant(args):
    app = pick(fetch_apps(args), args.app)
    scopes = csv_opt(args.scopes, SCOPES, "scope")
    if not scopes:
        return emit(err("--scopes is required", EX_USAGE), args.json)
    path = (f"/console/openapi/v2/app/{app['appId']}/api-scope"
            f"?manageDomainId={args.domain}")
    if args.dry_run:
        return emit(ok({"endpoint": path, "apiScopeList": scopes, "dry_run": True}),
                    args.json, human=f"[dry-run] would PUT {path}\n"
                                     f"          {', '.join(scopes)}")
    if not args.yes:
        return emit(err("refusing to change scopes without --yes", EX_USAGE), args.json)
    request(path, body={"apiScopeList": scopes}, method="PUT", debug=args.debug)
    return emit(ok({"app": app["appName"], "scopes": scopes}), args.json,
                human=f"granted to {app['appName']!r}: {', '.join(scopes)}")


def cmd_app_service_account(args):
    app = pick(fetch_apps(args), args.app)
    if app.get("accountEmail") and not args.remove:
        return emit(ok({"accountEmail": app["accountEmail"], "existing": True}),
                    args.json, human=f"already has one: {app['accountEmail']}")
    path = (f"/console/openapi/v2/app/{app['appId']}/service-account"
            f"?manageDomainId={args.domain}")
    verb = "DELETE" if args.remove else "PUT"
    if args.dry_run:
        return emit(ok({"endpoint": path, "method": verb, "dry_run": True}),
                    args.json, human=f"[dry-run] would {verb} {path}")
    if not args.yes:
        return emit(err(f"refusing to {verb.lower()} without --yes", EX_USAGE), args.json)
    res = request(path, method=verb, body=None if verb == "DELETE" else {},
                  debug=args.debug)
    email = (res or {}).get("accountEmail") if isinstance(res, dict) else None
    return emit(ok(res), args.json,
                human=f"removed" if args.remove else f"created {email}")


def cmd_app_rsakey(args):
    """Every call to this endpoint MINTS A NEW KEY PAIR and invalidates the old
    one - the console says '有效的密鑰僅限1個'. Verified: two calls return two
    different keys, and the app's publicKey follows the latest. So an app that
    already has a key is refused unless --rotate is passed explicitly."""
    app = pick(fetch_apps(args), args.app)
    has_key = bool(app.get("publicKey"))
    if has_key and not args.rotate:
        return emit(err(f"{app['appName']!r} already has a key; downloading mints "
                        f"a NEW one and breaks whatever uses the current key. "
                        f"Pass --rotate if that is what you want.", EX_USAGE),
                    args.json)
    path = (f"/console/openapi/v2/app/{app['appId']}/rsakey/download"
            f"?manageDomainId={args.domain}")
    out = args.out or f"{app['appName'].replace(' ', '_')}.pem"
    if args.dry_run:
        return emit(ok({"endpoint": path, "out": out, "rotates": has_key,
                        "dry_run": True}), args.json,
                    human=f"[dry-run] would GET {path}\n"
                          f"          -> {out}" +
                          ("\n          THIS ROTATES THE EXISTING KEY" if has_key else ""))
    if not args.yes:
        return emit(err("refusing to mint a key without --yes", EX_USAGE), args.json)
    pem = request(path, debug=args.debug, raw_bytes=True)
    if b"PRIVATE KEY" not in pem:
        return emit(err("response was not a PEM", detail=pem[:120].decode(
            "utf-8", "replace")), args.json)
    fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "wb") as f:
        f.write(pem)
    return emit(ok({"out": out, "bytes": len(pem), "rotated": has_key}), args.json,
                human=f"wrote {out} ({len(pem)} bytes, mode 600)")


# secrets are base64-ish and DO contain '+' - anchor on the closing tag rather
# than guessing the alphabet, or the value silently truncates at the first '+'
_MIME = {".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg",
         ".gif": "image/gif", ".webp": "image/webp"}


def upload_photo(path, args):
    """POST the file as multipart to the console's uploader, which answers
    {photoUrl}. Written by hand because the stdlib has no multipart encoder."""
    ext = os.path.splitext(path)[1].lower()
    if ext not in _MIME:
        raise SystemExit(f"unsupported image type {ext or '(none)'} "
                         f"(want {', '.join(sorted(_MIME))})")
    with open(path, "rb") as f:
        blob = f.read()
    boundary = "----worksdev" + os.urandom(8).hex()
    body = b"".join([
        f"--{boundary}\r\n".encode(),
        b'Content-Disposition: form-data; name="imageFile"; filename="'
        + os.path.basename(path).encode() + b'"\r\n',
        f"Content-Type: {_MIME[ext]}\r\n\r\n".encode(),
        blob, b"\r\n", f"--{boundary}--\r\n".encode()])
    res = request("/console/bot/img/upload", data_bytes=body,
                  content_type=f"multipart/form-data; boundary={boundary}",
                  debug=args.debug,
                  headers={"Referer": f"{BASE}/console/bot/form"})
    url = (res or {}).get("photoUrl")
    if not url:
        raise SystemExit(f"upload rejected: {(res or {}).get('message') or res}")
    return url


def resolve_photo(value, args, dry=False):
    """--photo takes either an https URL (used as-is; the console accepts
    external hosts - one live bot points at cdn.phototourl.com) or a local
    file, which gets uploaded first. With neither, fall back to your own
    default avatar if you have one, else the console placeholder."""
    if not value:
        value = os.environ.get("WORKSDEV_DEFAULT_PHOTO")
        if not value and os.path.isfile(DEFAULT_AVATAR_FILE):
            value = DEFAULT_AVATAR_FILE
    if not value:
        return DEFAULT_BOT_PHOTO
    if value.startswith(("http://", "https://")):
        return value
    if not os.path.isfile(value):
        raise SystemExit(f"--photo: no such file {value!r} "
                         f"(and it is not an http(s) URL)")
    # a dry run must not upload - that would store a real asset server-side
    return f"<would upload {value}>" if dry else upload_photo(value, args)


_SECRET_RE = re.compile(r'id="botSecret"[^>]*>([^<]+)<')


def cmd_bot_show(args):
    page = get(f"/console/bot/info/{args.bot}", expect_json=False, debug=args.debug)
    html = page.get("_raw", "")
    m = _SECRET_RE.search(html)
    # the info page labels its fields in the tenant's language; the list page
    # markup is stable, so take the name from there instead
    name = next((b["name"] for b in parse_bots(
        get("/console/bot/list", expect_json=False, debug=args.debug).get("_raw", ""))
        if str(b["botNo"]) == str(args.bot)), None)
    out = {"botNo": args.bot, "name": name,
           "botSecret": m.group(1).strip() if m else None}
    if not args.reveal and out["botSecret"]:
        out["botSecret"] = "•" * len(out["botSecret"])
    return emit(ok(out), args.json,
                human="\n".join(f"  {k}: {v}" for k, v in out.items()))


# ------------------------------------------------------------ admin plane
def admin(path, body=None, method="POST", debug=False):
    """admin.worksmobile.com is a separate host with its own tenant id in the
    path, and it wants the version header on every bot call."""
    return request(f"/api/{ADMIN_TENANT}{path}", body=body, method=method,
                   debug=debug, base=ADMIN_BASE,
                   headers={"X-WORKS-ADMIN-VERSION": "2",
                            "Origin": ADMIN_BASE,
                            "Referer": f"{ADMIN_BASE}/service/bot"})


def admin_bots(registered, args, page=1):
    res = admin("/botapi/internal/admin/getBotList",
                {"register": registered, "language": "zh-TW",
                 "pageIndex": page, "pagePerLength": 100}, debug=args.debug)
    return (res or {}).get("botList") or []


def cmd_admin_pending(args):
    bots = admin_bots(False, args)
    if args.json:
        return emit(ok(bots), True)
    if not bots:
        return emit(ok(bots), False, "(nothing pending - every bot is enabled)")
    return emit(ok(bots), False, "\n".join(
        f"  {(b.get('name') or {}).get('default','?')}  {b.get('botNo')}" for b in bots))


def cmd_admin_list(args):
    bots = admin_bots(True, args)
    if args.json:
        return emit(ok(bots), True)
    return emit(ok(bots), False, "\n".join(
        f"  {(b.get('name') or {}).get('default','?')}  {b.get('botNo')}  "
        f"status={b.get('status')}" for b in bots) or "(no bots)")


def enable_bot(bot_no, args):
    """registerBot only ADDS the bot to the tenant, at status 1 (off) - the
    console's own toggle then flips it to 2. Verified on a fresh bot: after
    registerBot it listed as status=1 alongside six status=2 bots. So a real
    'enable' is both calls. allowUserNoList [0] is the console's 'everyone'."""
    admin("/botapi/internal/admin/registerBot", {"botNo": int(bot_no)},
          debug=args.debug)
    if not getattr(args, "register_only", False):
        admin("/botapi/internal/admin/updateBotStatus",
              {"botNo": int(bot_no), "status": 2,
               "allowUserNoList": [int(u) for u in (
                   getattr(args, "allow", None) or "0").split(",") if u.strip()]},
              debug=args.debug)
    return next((b for b in admin_bots(True, args)
                 if str(b.get("botNo")) == str(bot_no)), None)


def cmd_admin_enable(args):
    if args.dry_run:
        steps = ["registerBot {botNo}"] + ([] if args.register_only else
                                           ["updateBotStatus status=2"])
        return emit(ok({"botNo": args.bot, "steps": steps, "dry_run": True}),
                    args.json, human=f"[dry-run] bot {args.bot}: " + " then ".join(steps))
    if not args.yes:
        return emit(err("refusing to enable without --yes", EX_USAGE), args.json)
    b = enable_bot(args.bot, args)
    if not b:
        return emit(err(f"bot {args.bot} is not in the enabled list afterwards"),
                    args.json)
    return emit(ok({"botNo": args.bot, "status": b.get("status")}), args.json,
                human=f"enabled bot {args.bot} (status={b.get('status')})")


def cmd_admin_status(args):
    body = {"botNo": int(args.bot), "status": args.status,
            "allowUserNoList": [int(u) for u in (args.allow or "").split(",") if u.strip()]}
    if args.dry_run:
        return emit(ok({"body": body, "dry_run": True}), args.json,
                    human=f"[dry-run] would POST updateBotStatus {body}")
    if not args.yes:
        return emit(err("refusing to change status without --yes", EX_USAGE), args.json)
    admin("/botapi/internal/admin/updateBotStatus", body, debug=args.debug)
    return emit(ok(body), args.json, human=f"bot {args.bot} status={args.status}")


# --------------------------------------------------------------- onboard
def cmd_onboard(args):
    """app -> scopes -> service account -> key -> bot -> enable, then print the
    openclaw account block. Each step prints as it lands, and a failure reports
    what already exists so you can finish by hand instead of re-running blind."""
    done = []

    def step(msg):
        print(f"  {msg}", file=sys.stderr)
        done.append(msg)

    scopes = csv_opt(args.scopes, SCOPES, "scope") or ["bot", "bot.read"]
    # the app and the bot are separate objects and usually want separate
    # names (this tenant pairs 'Racco-Nike App' with a bot called 學妹)
    bot_name = args.bot_name or args.name
    key_out = args.key_out or f"{args.name.replace(' ', '_')}.pem"
    if args.dry_run:
        plan = ["validate + create app", f"grant scopes: {', '.join(scopes)}",
                "create service account", f"mint RSA key -> {key_out}",
                f"create bot {bot_name!r}", "enable bot in admin"]
        return emit(ok({"plan": plan, "dry_run": True}), args.json,
                    human="[dry-run] would:\n" + "\n".join(f"  {i+1}. {s}"
                                                           for i, s in enumerate(plan)))
    if not args.yes:
        return emit(err("refusing to provision without --yes", EX_USAGE), args.json)
    try:
        if not app_name_free(args.name, args):
            return emit(err(f"app name {args.name!r} is already taken"), args.json)
        res = request(f"/console/openapi/v2/app?manageDomainId={args.domain}",
                      body={"appName": args.name}, debug=args.debug)
        app_id = res if isinstance(res, str) else (res or {}).get("_raw")
        step(f"app created: {app_id}")

        request(f"/console/openapi/v2/app/{app_id}/api-scope?manageDomainId={args.domain}",
                body={"apiScopeList": scopes}, method="PUT", debug=args.debug)
        step(f"scopes granted: {', '.join(scopes)}")

        sa = request(f"/console/openapi/v2/app/{app_id}/service-account"
                     f"?manageDomainId={args.domain}", body={}, method="PUT",
                     debug=args.debug)
        step(f"service account: {(sa or {}).get('accountEmail')}")

        pem = request(f"/console/openapi/v2/app/{app_id}/rsakey/download"
                      f"?manageDomainId={args.domain}", debug=args.debug,
                      raw_bytes=True)
        fd = os.open(key_out, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "wb") as f:
            f.write(pem)
        step(f"private key: {key_out} ({len(pem)} bytes)")

        photo = resolve_photo(args.photo, args)
        if args.photo:
            step(f"avatar: {photo}")

        bot_body = {
            "botNo": "", "name": {"default": bot_name},
            "description": {"default": args.description},
            "photoUrl": {"default": photo},
            "joinTypeList": ["group"] if args.group else [],
            "usePersistantMenu": False, "callbackUrl": args.callback_url or "",
            "callbackEventList": ["text", "image"] if args.callback_url else [],
            "channelEventList": ["message"] if args.callback_url else [],
            "managerList": [int(args.manager or current_user_no(args))],
            "submanagerList": [], "interfaceType": 1, "allowDomainIdList": [0],
        }
        br = request("/console/bot/register", body=bot_body, debug=args.debug)
        if (br or {}).get("code") != "00":
            raise SystemExit(f"bot create failed (code {(br or {}).get('code')})")
        bots = [b for b in parse_bots(get("/console/bot/list", expect_json=False,
                                          debug=args.debug).get("_raw", ""))
                if b["name"] == bot_name]
        if not bots:
            raise SystemExit("bot created but could not find its botNo")
        bot_no = bots[0]["botNo"]
        step(f"bot created: {bot_no}")

        html = get(f"/console/bot/info/{bot_no}", expect_json=False,
                   debug=args.debug).get("_raw", "")
        m = _SECRET_RE.search(html)
        bot_secret = m.group(1).strip() if m else None
        step("bot secret read" if bot_secret else "bot secret NOT found")

        b = enable_bot(bot_no, args)
        enabled = bool(b) and b.get("status") == 2
        step(f"enabled in admin (status={b.get('status') if b else '?'})")
    except (SystemExit, ApiError, Auth) as e:
        print(f"\nFAILED: {e}\ncompleted so far:", file=sys.stderr)
        for d in done:
            print(f"  - {d}", file=sys.stderr)
        return EX_ERR

    app = pick(fetch_apps(args), app_id)
    account = {
        "name": bot_name, "botId": bot_no, "botSecret": bot_secret,
        "webhookPath": f"/lineworks/{args.account or args.name.lower()}/webhook",
    }
    channel = {
        "clientId": app.get("clientId"), "clientSecret": app.get("clientSecret"),
        "serviceAccount": app.get("accountEmail"),
        "privateKeyFile": os.path.abspath(key_out), "domainId": args.domain,
    }
    out = {"appId": app_id, "botNo": bot_no, "enabled": enabled,
           "channel": channel, "account": account}
    if args.json:
        return emit(ok(out), True)
    return emit(ok(out), False,
                "\nopenclaw config — channels.lineworks:\n" +
                json.dumps(channel, ensure_ascii=False, indent=2) +
                f"\n\nchannels.lineworks.accounts.{args.account or args.name.lower()}:\n" +
                json.dumps(account, ensure_ascii=False, indent=2))


# ---------------------------------------------------- app read-modify-write
def _list_items(html, list_id):
    """<ul id="..."><li><span>value</span></li>…</ul> - the console reads its
    own rendered list back out the same way."""
    m = re.search(r'id="%s"[^>]*>(.*?)</ul>' % list_id, html, re.S)
    return [] if not m else [t.strip() for t in
                             re.findall(r"<span[^>]*>([^<]*)</span>", m.group(1))
                             if t.strip()]


def read_app(app, args):
    """Rebuild the whole PATCH payload. A partial PATCH is rejected outright
    (400 INVALID_PARAMETER), so every field has to be supplied - and the edit
    form is the only place several of them exist."""
    html = get(f"/console/openapi/v2/app/edit/view/{app['appId']}"
               f"?manageDomainId={args.domain}", expect_json=False,
               debug=args.debug).get("_raw", "")
    if "app_name_input" not in html:
        raise SystemExit(f"could not load the edit form for {app['appName']!r}")
    users = get(f"/console/openapi/v2/app/{app['appId']}/app-users"
                f"?manageDomainId={args.domain}", debug=args.debug) or {}
    desc = re.search(r'id="app_desc_input"[^>]*>([^<]*)</textarea>', html)
    tenant = re.search(r'<input[^>]*id="radio_access_type_tenant"[^>]*>', html)
    sel = re.search(r'<input[^>]*id="selected_user_access_button"[^>]*>', html)
    return {
        "appName": app.get("appName"),
        "appDescription": desc.group(1).strip() if desc else "",
        "redirectUrlList": _list_items(html, "url_list"),
        # note the shape: this endpoint wants objects, while the dedicated
        # PUT .../api-scope endpoint wants bare strings for the same thing
        "apiScopeList": [{"scope": s} for s in _list_items(html, "scope_list")],
        "accessType": ("TENANT" if tenant and "checked" in tenant.group(0)
                       else "DOMAIN"),
        "logoutRedirectUrlList": _list_items(html, "logout_url_list"),
        "accessTokenTtl": app.get("accessTokenTtl"),
        "refreshTokenRotationYn": app.get("refreshTokenRotationYn"),
        "userAccessType": ("SELECTED" if sel and "checked" in sel.group(0)
                           else users.get("userAccessType") or "ALL"),
        "accessUserIdNoList": [str(u.get("userIdNo") or u.get("id"))
                               for u in (users.get("userInfoList") or [])],
    }


def cmd_app_set(args):
    app = pick(fetch_apps(args), args.app)
    before = read_app(app, args)
    after = json.loads(json.dumps(before))
    if args.name:
        after["appName"] = args.name
    if args.description is not None:
        after["appDescription"] = args.description
    if args.scopes is not None:
        after["apiScopeList"] = [{"scope": s} for s in
                                 csv_opt(args.scopes, SCOPES, "scope")]
    if args.redirect_urls is not None:
        after["redirectUrlList"] = [u.strip() for u in
                                    args.redirect_urls.split(",") if u.strip()]
    if args.ttl:
        after["accessTokenTtl"] = args.ttl
    if args.rotation:
        after["refreshTokenRotationYn"] = args.rotation

    changed = {k: (before[k], after[k]) for k in after if before[k] != after[k]}
    if not changed:
        return emit(ok({"app": app["appName"], "changed": {}}), args.json,
                    human="nothing to change")
    diff = "\n".join(
        f"  {k}:\n    - {json.dumps(o, ensure_ascii=False)}\n"
        f"    + {json.dumps(n, ensure_ascii=False)}" for k, (o, n) in changed.items())
    if args.dry_run:
        return emit(ok({"changed": changed, "payload": after, "dry_run": True}),
                    args.json, human=f"[dry-run] {app['appName']!r}\n{diff}")
    if not args.yes:
        return emit(err("refusing to modify without --yes", EX_USAGE), args.json)
    kind = {"SCIM": "scim-app", "AUTH_DELEGATION": "auth-delegated-app"}.get(
        app.get("clientAppType"), "app")
    request(f"/console/openapi/v2/{kind}/{app['appId']}?manageDomainId={args.domain}",
            body=after, method="PATCH", debug=args.debug)
    return emit(ok({"app": app["appName"], "changed": list(changed)}), args.json,
                human=f"updated {app['appName']!r}\n{diff}")


def cmd_app_delete(args):
    app = pick(fetch_apps(args), args.app)
    kind = {"SCIM": "scim-app", "AUTH_DELEGATION": "auth-delegated-app"}.get(
        app.get("clientAppType"), "app")
    path = f"/console/openapi/v2/{kind}/{app['appId']}?manageDomainId={args.domain}"
    if args.dry_run:
        return emit(ok({"endpoint": path, "method": "DELETE", "dry_run": True}),
                    args.json, human=f"[dry-run] would DELETE {app['appName']!r}\n"
                                     f"          {path}")
    if not args.yes:
        return emit(err("refusing to delete without --yes", EX_USAGE), args.json)
    request(path, method="DELETE", debug=args.debug)
    gone = not any(a.get("appId") == app["appId"] for a in fetch_apps(args))
    return emit(ok({"deleted": app["appName"], "gone": gone}), args.json,
                human=f"deleted {app['appName']!r}" if gone else
                      f"DELETE returned ok but {app['appName']!r} is still listed")


# ---------------------------------------------------- bot read-modify-write
def _i18n_langs_on(html, field):
    """Only rows carrying class 'on' go into an i18n map - that is what the
    console's own _getI18nValues does."""
    return {m.group(1) for m in re.finditer(
        r'class="_%sTr[^"]*\bon\b"[^>]*data-lang="([^"]*)"' % field, html)}


def _i18n_inputs(html, cls, textarea=False):
    if textarea:
        pat = r'%s[^>]*data-lang="([^"]*)"[^>]*>([^<]*)</textarea>' % cls
    else:
        pat = r'%s[^>]*data-lang="([^"]*)"[^>]*value="([^"]*)"' % cls
    return dict(re.findall(pat, html))


def _checked(html, ident):
    m = re.search(r'<input[^>]*id="%s"[^>]*>' % re.escape(ident), html)
    return bool(m and "checked" in m.group(0))


def read_bot(bot_no, args):
    """Reconstruct the FULL bot object the console would submit. The modify
    form is authoritative for the i18n maps, callback settings and events;
    managers are not in the markup (JS fills them in later), so those come
    from the admin console's getBotInfo. If managers cannot be read we refuse
    to write, because sending an empty managerList would orphan the bot."""
    html = get(f"/console/bot/modify/view/{bot_no}", expect_json=False,
               debug=args.debug).get("_raw", "")
    if "_botName" not in html:
        raise SystemExit(f"could not load the modify form for bot {bot_no} "
                         f"(deleted, or not yours)")
    names = _i18n_inputs(html, "_botName")
    descs = _i18n_inputs(html, "_botDesc", textarea=True)
    photos = _i18n_inputs(html, "_botProfileUrl")
    off = _checked(html, "callback_off")
    cb = re.search(r'_callbackUrl[^>]*value="([^"]*)"', html)

    info = admin("/botapi/internal/admin/getBotInfo",
                 {"botNo": int(bot_no), "language": "zh-TW"}, debug=args.debug)
    if not isinstance(info, dict) or "managerList" not in info:
        raise SystemExit(f"could not read managers for bot {bot_no}; refusing "
                         f"to write a payload that would clear them")

    return {
        "botNo": str(bot_no),
        "name": {k: v for k, v in names.items()
                 if k in _i18n_langs_on(html, "name")},
        "description": {k: v for k, v in descs.items()
                        if k in _i18n_langs_on(html, "desc")},
        "photoUrl": {k: v for k, v in photos.items()
                     if k in _i18n_langs_on(html, "profile")},
        "joinTypeList": ["group"] if _checked(html, "check_chat1") else [],
        "usePersistantMenu": False,
        "callbackUrl": "" if off else (cb.group(1) if cb else ""),
        "callbackEventList": [] if off else [
            v for i, v in (("chk_msg_txt", "text"), ("chk_msg_place", "location"),
                           ("chk_msg_sticker", "sticker"), ("chk_msg_photo", "image"),
                           ("chk_msg_file", "file"), ("chk_msg_audio", "audio"),
                           ("chk_msg_video", "video")) if _checked(html, i)],
        "channelEventList": [] if off else [
            e for e in CHANNEL_EVENTS if _checked(html, f"chk_{e}")],
        "managerList": info["managerList"],
        "submanagerList": info.get("submanagerList") or [],
        "interfaceType": 1,
        "allowDomainIdList": [0],
    }


def cmd_bot_set(args):
    before = read_bot(args.bot, args)
    after = json.loads(json.dumps(before))  # deep copy
    if args.name:
        after["name"]["default"] = args.name
    if args.description:
        after["description"]["default"] = args.description
    if args.photo:
        after["photoUrl"]["default"] = resolve_photo(args.photo, args,
                                                     dry=args.dry_run)
    if args.callback_url is not None:
        after["callbackUrl"] = args.callback_url
        if not args.callback_url:
            after["callbackEventList"], after["channelEventList"] = [], []
    if args.events is not None:
        after["channelEventList"] = csv_opt(args.events, CHANNEL_EVENTS, "event")
    if args.message_types is not None:
        after["callbackEventList"] = csv_opt(args.message_types, MESSAGE_TYPES,
                                             "message type")
    if args.group is not None:
        after["joinTypeList"] = ["group"] if args.group else []
    if args.manager:
        after["managerList"] = [int(u) for u in args.manager.split(",") if u.strip()]

    changed = {k: (before[k], after[k]) for k in after if before[k] != after[k]}
    if not changed:
        return emit(ok({"botNo": args.bot, "changed": {}}), args.json,
                    human="nothing to change")
    diff = "\n".join(
        f"  {k}:\n    - {json.dumps(o, ensure_ascii=False)}\n"
        f"    + {json.dumps(n, ensure_ascii=False)}" for k, (o, n) in changed.items())
    if args.dry_run:
        return emit(ok({"changed": changed, "payload": after, "dry_run": True}),
                    args.json, human=f"[dry-run] bot {args.bot}\n{diff}")
    if not args.yes:
        return emit(err("refusing to modify without --yes", EX_USAGE), args.json)
    res = request("/console/bot/modify", body=after, debug=args.debug)
    if (res or {}).get("code") != "00":
        return emit(err(f"modify failed (code {(res or {}).get('code')})",
                        detail=res), args.json)
    return emit(ok({"botNo": args.bot, "changed": list(changed)}), args.json,
                human=f"updated bot {args.bot}\n{diff}")


def cmd_bot_secret_reissue(args):
    """Invalidates the current secret immediately - anything running with the
    old one starts failing webhook verification."""
    if args.dry_run:
        return emit(ok({"endpoint": f"/console/bot/modify-secret/{args.bot}",
                        "dry_run": True}), args.json,
                    human=f"[dry-run] would GET /console/bot/modify-secret/{args.bot}")
    if not args.yes:
        return emit(err("refusing to re-issue without --yes", EX_USAGE), args.json)
    request(f"/console/bot/modify-secret/{args.bot}", debug=args.debug,
            headers={"Referer": f"{BASE}/console/bot/info/{args.bot}"})
    html = get(f"/console/bot/info/{args.bot}", expect_json=False,
               debug=args.debug).get("_raw", "")
    m = _SECRET_RE.search(html)
    secret = m.group(1).strip() if m else None
    return emit(ok({"botNo": args.bot, "botSecret": secret}), args.json,
                human=f"re-issued; new secret: {secret}\n"
                      f"update every config that holds the old one")


def cmd_bot_delete(args):
    """Deletes the bot itself, unlike `admin bot remove` which only un-enrols
    it from the tenant. Note this is a GET that mutates - the console really
    does it that way; there is no body and no manageDomainId."""
    path = f"/console/bot/remove/{args.bot}"
    if args.dry_run:
        return emit(ok({"endpoint": path, "method": "GET", "dry_run": True}),
                    args.json, human=f"[dry-run] would GET {path}")
    if not args.yes:
        return emit(err("refusing to delete without --yes", EX_USAGE), args.json)
    res = request(path, debug=args.debug,
                  headers={"Referer": f"{BASE}/console/bot/view"})
    still = any(str(b["botNo"]) == str(args.bot) for b in parse_bots(
        get("/console/bot/list", expect_json=False, debug=args.debug).get("_raw", "")))
    return emit(ok({"botNo": args.bot, "deleted": not still, "response": res}),
                args.json,
                human=f"deleted bot {args.bot}" if not still else
                      f"remove returned {res} but {args.bot} is still listed")


def cmd_admin_remove(args):
    body = {"botNo": int(args.bot)}
    if args.dry_run:
        return emit(ok({"body": body, "dry_run": True}), args.json,
                    human=f"[dry-run] would POST removeBot {body}")
    if not args.yes:
        return emit(err("refusing to remove without --yes", EX_USAGE), args.json)
    admin("/botapi/internal/admin/removeBot", body, debug=args.debug)
    still = any(str(b.get("botNo")) == str(args.bot) for b in admin_bots(True, args))
    return emit(ok({"botNo": args.bot, "removed": not still}), args.json,
                human=f"removed bot {args.bot} from the tenant" if not still else
                      f"removeBot ran but {args.bot} is still listed")


def cmd_raw(args):
    return emit(ok(get(args.path, expect_json=not args.html, debug=args.debug)), True)


def build_parser():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", help="JSON envelope")
    common.add_argument("--debug", action="store_true", help="requests to stderr")
    common.add_argument("--domain", default=DOMAIN, help=f"manageDomainId (default {DOMAIN})")
    common.add_argument("--count", type=int, default=100)
    common.add_argument("--cursor", type=int, default=1)

    # every mutation is opt-in twice: --dry-run shows the exact payload, and
    # nothing is sent without --yes. These act on a live corporate tenant.
    write = argparse.ArgumentParser(add_help=False)
    write.add_argument("--yes", action="store_true", help="actually do it")
    write.add_argument("--dry-run", action="store_true",
                       help="print the request that would be sent, send nothing")

    p = argparse.ArgumentParser(prog="worksdev", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    d = sub.add_parser("doctor", parents=[common], help="verify the session")
    d.set_defaults(fn=cmd_doctor)

