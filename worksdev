def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        return args.fn(args)
    except Auth as e:
        return emit(err(str(e), EX_AUTH), args.json)
    except ApiError as e:
        return emit(err(str(e), detail=e.body[:500]), args.json)


if __name__ == "__main__":
    sys.exit(main())
